# Copia como .env y coloca la URL EXTERNA de PostgreSQL de Render.
DATABASE_URL=postgresql://usuario:contrasena@host-externo:5432/base_de_datos

# Opcionales: si quedan vacÃ­as, Google se toma de Social applications en la BD.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DEBUG=true
SECRET_KEY=django-insecure-local-development-only
SITE_ID=2
ALLOWED_HOSTS=localhost,127.0.0.1


