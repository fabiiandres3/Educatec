# Copia como .env y coloca la URL EXTERNA de PostgreSQL de Render.
DATABASE_URL=postgresql://usuario:contrasena@host-externo:5432/base_de_datos

# Supabase Storage S3 (valores del panel Storage > S3 Configuration).
# Endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Completa los cuatro campos para activar Supabase; no subas el .env real.
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=educatec-media

# Opcionales: si quedan vacÃ¬as, Google se toma de Social applications en la BD.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DEBUG=true
SECRET_KEY=django-insecure-local-development-only
SITE_ID=2
ALLOWED_HOSTS=localhost,127.0.0.1